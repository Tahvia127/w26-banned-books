   "source": [
    "#extract each \"type\" of reason from the genre column\n",
    "GENRE_COL = \"Genre\"\n",
    "def split_genres(x):\n",
    "    if pd.isna(x):\n",
    "        return []\n",
    "    return [g.strip().upper() for g in re.split(r\"[;,/]\", str(x)) if g.strip()]\n",
    "\n",
    "df[\"genres_list\"] = df[GENRE_COL].apply(split_genres)\n",
    "df[\"genres_list\"].head(10)\n"
   ]
